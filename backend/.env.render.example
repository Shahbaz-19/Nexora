# Copy these names into Render's Environment page. Never commit real values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=generate-at-least-32-random-bytes
GROQ_API_KEY=set-in-render-secret-environment
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=set-in-render-secret-environment
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=50
RERANKER_PROVIDER=none

# Use the exact production Vercel URL. Add comma-separated trusted origins only.
CORS_ORIGINS=https://your-project.vercel.app
# Optional for Vercel previews; anchor and scope this to your project/team.
CORS_ORIGIN_REGEX=
COOKIE_SECURE=true
COOKIE_SAMESITE=none

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GROQ_TIMEOUT_SECONDS=45
MAX_UPLOAD_BYTES=10485760
STALE_PROCESSING_MINUTES=30
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=300

# Hosted embeddings and RRF-only ranking avoid loading PyTorch in this service.
